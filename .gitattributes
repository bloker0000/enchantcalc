# Normalise text files to LF in the repository; checkouts use the platform default.
* text=auto

# Shell scripts must keep LF (CI runs on Linux), batch files CRLF.
/gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.gif binary
*.webp binary
*.zip binary
